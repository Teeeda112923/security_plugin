# Copy to .env for local development (values are examples).

# Local dev uses SQLite by default; in production set a Postgres URL.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/cybernote

# Vulnerability feed source — set ONE of these (see app/ingest.py).
FEED_FILE=tests/fixtures/sample_feed.json
# FEED_URL=https://example.com/vulnerability-feed.json
# FEED_TOKEN=your-feed-api-token

# License key prefix (matches the plugin's CNSC branding).
LICENSE_PREFIX=CNSC
