# ─── B-1: Debug mode ─────────────────────────────────────────────────────────
msgid "デバッグモード"
msgstr "デバッグモード"

msgid "wp-config.phpでWP_DEBUGをfalseに設定してください（現在有効: 情報漏洩リスクあり）"
msgstr "wp-config.phpでWP_DEBUGをfalseに設定してください（現在有効: 情報漏洩リスクあり）"

msgid "WP_DEBUG: true（本番環境では無効化推奨）"
msgstr "WP_DEBUG: true（本番環境では無効化推奨）"

msgid "WP_DEBUG: false（正常）"
msgstr "WP_DEBUG: false（正常）"

# ─── B-2: File editing ───────────────────────────────────────────────────────
msgid "ファイル編集機能"
msgstr "ファイル編集機能"

msgid "wp-config.phpに define('DISALLOW_FILE_EDIT', true); を追加してください（テーマ・プラグインの不正編集を防止）"
msgstr "wp-config.phpに define('DISALLOW_FILE_EDIT', true); を追加してください（テーマ・プラグインの不正編集を防止）"

msgid "DISALLOW_FILE_EDIT: true（管理画面からの編集を無効化済み）"
msgstr "DISALLOW_FILE_EDIT: true（管理画面からの編集を無効化済み）"

msgid "DISALLOW_FILE_EDIT: 未設定（管理画面からファイル編集が可能）"
msgstr "DISALLOW_FILE_EDIT: 未設定（管理画面からファイル編集が可能）"

# ─── B-3: HTTPS ──────────────────────────────────────────────────────────────
msgid "HTTPS設定"
msgstr "HTTPS設定"

msgid "SSL証明書を導入し、常時HTTPSを設定してください（現在: HTTP運用中）"
msgstr "SSL証明書を導入し、常時HTTPSを設定してください（現在: HTTP運用中）"

msgid "HTTPS: 有効（SSL証明書が適用されています）"
msgstr "HTTPS: 有効（SSL証明書が適用されています）"

msgid "HTTPS: 無効（HTTP接続）"
msgstr "HTTPS: 無効（HTTP接続）"

# ─── B-4: Login URL ──────────────────────────────────────────────────────────
msgid "ログインURL"
msgstr "ログインURL"

msgid "ログインURLを変更するプラグイン（例: WPS Hide Login）の導入を検討してください（デフォルトURL: /wp-login.php）"
msgstr "ログインURLを変更するプラグイン（例: WPS Hide Login）の導入を検討してください（デフォルトURL: /wp-login.php）"

msgid "ログインURL変更プラグインが有効です"
msgstr "ログインURL変更プラグインが有効です"

msgid "デフォルトのログインURL (/wp-login.php) が使用されています"
msgstr "デフォルトのログインURL (/wp-login.php) が使用されています"

# ─── B-5: Admin username ─────────────────────────────────────────────────────
msgid "管理者ユーザー名"
msgstr "管理者ユーザー名"

msgid "ユーザー名 \"admin\" が存在します。別のユーザー名に変更してください（バックアップ後に実施）"
msgstr "ユーザー名 \"admin\" が存在します。別のユーザー名に変更してください（バックアップ後に実施）"

msgid "ユーザー名 \"admin\" は存在しません（良好）"
msgstr "ユーザー名 \"admin\" は存在しません（良好）"

msgid "ユーザー名 \"admin\" が検出されました（ブルートフォース攻撃のリスク）"
msgstr "ユーザー名 \"admin\" が検出されました（ブルートフォース攻撃のリスク）"

# ─── B-6: Database prefix ────────────────────────────────────────────────────
msgid "データベース接頭辞"
msgstr "データベース接頭辞"

msgid "DBテーブル接頭辞が \"wp_\" のままです。新規構築時には変更を推奨します（稼働中サイトでの変更は慎重に）"
msgstr "DBテーブル接頭辞が \"wp_\" のままです。新規構築時には変更を推奨します（稼働中サイトでの変更は慎重に）"

